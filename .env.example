# ============================================================
# Chain of Truth — Environment Variables
# Copy this file to .env in the SAME folder and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ---------- General ----------
ENVIRONMENT=development
APP_NAME="Chain of Truth"

# ---------- Database (PostgreSQL + pgvector) ----------
# POSTGRES_PASSWORD and the password inside DATABASE_URL MUST match — the
# compose file creates the container's superuser from POSTGRES_PASSWORD, and
# the backend connects with DATABASE_URL.
POSTGRES_USER=chain_of_truth
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=chain_of_truth
POSTGRES_HOST=localhost
# Port 5433 (not 5432) is deliberate: it avoids clashing with a PostgreSQL
# server already installed natively on the host. If you change it, change it
# in docker-compose.yml's `ports:` mapping and in DATABASE_URL below too.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://chain_of_truth:change_me_local_only@localhost:5433/chain_of_truth

# ---------- Object Storage (S3-compatible; MinIO locally) ----------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=evidence
S3_REGION=us-east-1
# For real AWS S3 in production, set S3_ENDPOINT_URL="" and use real IAM-scoped keys.

# ---------- Auth / Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AI Provider (provider-agnostic; set only the one you use) ----------
# AI_PROVIDER selects which block below is used: "groq" or "anthropic".
# Leaving the matching API key blank is supported: evidence still uploads,
# hashes, and logs correctly, and the AI stages are skipped with a warning
# (the UI receives an "evidence.ai_skipped" event) rather than erroring.
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Embeddings ----------
# Anthropic does not offer an embedding model; Voyage AI is Anthropic's
# recommended embeddings partner (https://docs.claude.com/en/docs/build-with-claude/embeddings).
# Leave VOYAGE_API_KEY blank to run on a local deterministic fallback embedding
# (fine for demoing the RAG pipeline end-to-end without any paid key).
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5

# ---------- Frontend ----------
# Read by Vite from this repo-root .env (see frontend/vite.config.ts `envDir`).
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws
